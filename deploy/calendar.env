AUTH_MODE=proxy
BIND_HOST=127.0.0.1
PORT=8110
DAV_PORT=8111
STORE_PORT=8112
DATA_DIR=/var/lib/calendar
TRUSTED_PROXIES=127.0.0.1,::1
USER_HEADER=X-Forwarded-User
ALLOWED_USERS=__SIGNED_IN_USER__
TIME_ZONE=Europe/London
CALDAV_ENABLED=false
CALDAV_USER=__CALDAV_USER__
CALDAV_REQUIRE_CLOUDFLARE_HTTPS=true
PUBLIC_URL=https://__SITE_HOST__
ARTY_URL=
ARTY_APPROVE_URL=
